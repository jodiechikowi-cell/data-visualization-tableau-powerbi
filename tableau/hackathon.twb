      <aliases enabled='yes' />
      <column caption='Seasons' datatype='string' name='[Calculation_301459719777435649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Order Month] IN (&apos;March&apos;, &apos;April&apos;, &apos;May&apos;) THEN &apos;Spring&apos;&#13;&#10;ELSEIF [Order Month] IN (&apos;June&apos;, &apos;July&apos;, &apos;August&apos;) THEN &apos;Summer&apos;&#13;&#10;ELSEIF [Order Month] IN (&apos;September&apos;, &apos;October&apos;, &apos;November&apos;) THEN &apos;Fall&apos;&#13;&#10;ELSEIF [Order Month] IN (&apos;December&apos;, &apos;January&apos;, &apos;February&apos;) THEN &apos;Winter&apos;&#13;&#10;ELSE &apos;Unknown&apos;&#13;&#10;END' />
      </column>
      <column caption='Yearly Quantity' datatype='integer' name='[Calculation_301459719784185858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Product Quantity])' />
      </column>
      <column caption='Percentage Change' datatype='real' name='[Calculation_301459719787610116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_301459719784185858] &gt; 0 THEN&#13;&#10;    ( [Calculation_301459719784185858] - LOOKUP([Calculation_301459719784185858], -1) ) / ABS(LOOKUP([Calculation_301459719784185858], -1))&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Difference Change' datatype='string' name='[Calculation_301459719788109829]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_301459719787610116] &gt; 0.2 THEN &apos;Significant Increase&apos;&#13;&#10;ELSEIF [Calculation_301459719787610116] &lt; -0.2 THEN &apos;Significant Decrease&apos;&#13;&#10;ELSE &apos;No Significant Change&apos;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Basket Size' datatype='integer' name='[Calculation_301459719796629512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Order ID] : SUM([Product Quantity]) }' />
      </column>
      <column datatype='integer' name='[Order ID]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[Order Year]' role='dimension' type='quantitative' />
