                <address>
                  <value>-1</value>
                </address>
              </table-calc>
            </column-instance>
            <column-instance column='[Calculation_301459719788109829]' derivation='User' name='[usr:Calculation_301459719788109829:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Rows' />
